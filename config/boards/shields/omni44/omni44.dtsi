/*
 * Omni44 v3 matrix definition.
 *
 * Each half has six columns and four rows. The PCB uses GPIO 1, 0, 2, 3, 4,
 * 5 for columns and GPIO 6, 7, 8, 9 for rows on the nice!nano v2.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &omni44_layout;
    };

    omni44_layout: omni44_layout {
        compatible = "zmk,physical-layout";
        display-name = "Omni44";
        transform = <&omni44_transform>;
    };

    omni44_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        // 12 keys per alpha row, then four thumb keys per half.
        map = <
            RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)
            RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)
            RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11)
            RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)
            RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11)
                                    RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)
                                    RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10)
        >;
    };

    joystick_buttons: joystick_buttons {
        compatible = "gpio-keys";
        status = "disabled";

        joystick_button: joystick_button {
            label = "Left joystick button";
            gpios = <&pro_micro 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            zephyr,code = <INPUT_BTN_2>;
        };
    };

    joystick_button_listener: joystick_button_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&joystick_buttons>;
    };

    joystick_axes: joystick_axes {
        compatible = "gpio-keys";
        status = "disabled";
        debounce-interval-ms = <30>;

        joystick_y: joystick_y {
            label = "Left joystick Y axis";
            gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
            zephyr,code = <INPUT_KEY_0>;
        };

        joystick_x: joystick_x {
            label = "Left joystick X axis";
            gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
            zephyr,code = <INPUT_KEY_1>;
        };
    };

    joystick_axes_listener: joystick_axes_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&joystick_axes>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
